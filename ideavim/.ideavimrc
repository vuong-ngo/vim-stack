" ============================================================
" Script: .ideavimrc
" Description: JetBrains IdeaVim configuration synchronized 1-to-1 with Vim & Neovim muscle memory.
" ============================================================

" --- 1. LEADER KEYS ---
let mapleader = " "
let maplocalleader = " "

" --- 2. GENERAL OPTIONS & SENSITIVE DEFAULTS ---
set showmode
set incsearch
set hlsearch
set ignorecase
set smartcase
set scrolloff=8
set sidescrolloff=8
set number
set relativenumber=false

" --- Native OS System Clipboard & JetBrains Paste Sync ---
set clipboard=unnamed,unnamedplus,ideaput

" --- 3. IDEAVIM NATIVE ENHANCEMENTS ---
set ideajoin              " Smart line join (J) recognizing language syntax
set ideastatusicon=enabled " Show IdeaVim mode icon in status bar
set idearefactormode=keep " Keep Vim mode active during IDE refactoring operations
set visualdelay=0

" Built-in Emulated Plugins
set surround              " Enable vim-surround (ys, cs, ds)
set multiple-cursors      " Enable multiple cursors (<A-n>, <A-x>, <A-p>)
set commentary            " Enable native commentary (gcc, gc)
set argtextobj            " Enable argument text objects (cia, daa)
set highlightedyank       " Highlight yanked text briefly
set ReplaceWithRegister   " Replace with register (gr)

" ============================================================
" --- 4. SYNCHRONIZED KEYBINDINGS ---
" ============================================================

" --- Tab / Buffer Navigation (Exact Parity with Neovim & Vim) ---
nnoremap H <Action>(PreviousTab)
nnoremap L <Action>(NextTab)

" Jump directly to Tab 1 through 9 (Alt + 1..9)
nnoremap <A-1> <Action>(GoToTab1)
nnoremap <A-2> <Action>(GoToTab2)
nnoremap <A-3> <Action>(GoToTab3)
nnoremap <A-4> <Action>(GoToTab4)
nnoremap <A-5> <Action>(GoToTab5)
nnoremap <A-6> <Action>(GoToTab6)
nnoremap <A-7> <Action>(GoToTab7)
nnoremap <A-8> <Action>(GoToTab8)
nnoremap <A-9> <Action>(GoToTab9)

" --- File Explorer & Quick Search ---
nnoremap <leader>e <Action>(ActivateProjectToolWindow)

" Quick File Finder (Ctrl + P or <leader>ff)
nnoremap <C-p> <Action>(GotoFile)
nnoremap <leader>ff <Action>(GotoFile)

" Live Grep / Search Text in Project (Ctrl + F or <leader>fg)
nnoremap <C-f> <Action>(FindInPath)
nnoremap <leader>fg <Action>(FindInPath)

" Recent Files (<leader>fr)
nnoremap <leader>fr <Action>(RecentFiles)

" Switcher / Open Buffers (<leader>fb)
nnoremap <leader>fb <Action>(Switcher)

" Global Search & Replace (<leader>sr)
nnoremap <leader>sr <Action>(ReplaceInPath)

" Clear Search Highlight (<Esc>)
nnoremap <Esc> :nohlsearch<CR>

" --- Window Splits & Navigation ---
nnoremap <leader>\| <Action>(SplitVertically)
nnoremap <leader>- <Action>(SplitHorizontally)

" Navigate between splits (Ctrl + h/j/k/l)
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Resize split windows (Ctrl + Arrows)
nnoremap <C-Up> <Action>(ResizeToolWindowUp)
nnoremap <C-Down> <Action>(ResizeToolWindowDown)
nnoremap <C-Left> <Action>(ResizeToolWindowLeft)
nnoremap <C-Right> <Action>(ResizeToolWindowRight)

" --- Editing & Code Navigation ---
" Seamless Copy & Paste with System Clipboard (Insert & Command modes)
vnoremap <C-c> <Action>($Copy)
vnoremap <C-x> <Action>($Cut)
inoremap <C-v> <Action>($Paste)
cnoremap <C-v> <Action>($Paste)

" Wrapped line navigation
nnoremap j gj
nnoremap k gk
vnoremap j gj
vnoremap k gk

" Move Selected Lines Up / Down (Alt + j / Alt + k)
nnoremap <A-j> <Action>(MoveLineDown)
nnoremap <A-k> <Action>(MoveLineUp)
vnoremap <A-j> <Action>(MoveLineDown)
vnoremap <A-k> <Action>(MoveLineUp)

" Continuous Visual Indentation
vnoremap < <gv
vnoremap > >gv

" Integrated Terminal (<C-/> or <leader>ft)
nnoremap <C-/> <Action>(ActivateTerminalToolWindow)
nnoremap <leader>ft <Action>(ActivateTerminalToolWindow)

" --- Code Actions, Formatting & LSP ---
nnoremap <leader>ca <Action>(ShowIntentionActions)
nnoremap <leader>rn <Action>(RenameElement)
nnoremap <leader>cf <Action>(ReformatCode)

" Code navigation helpers
nnoremap gd <Action>(GotoDeclaration)
nnoremap gr <Action>(FindUsages)
nnoremap gi <Action>(GotoImplementation)
nnoremap K <Action>(QuickJavaDoc)
nnoremap [d <Action>(GotoPreviousError)
nnoremap ]d <Action>(GotoNextError)
