" ============================================================
" Script: .ideavimrc
" Description: JetBrains IdeaVim configuration synchronized 1-to-1 with Vim & Neovim muscle memory.
" ============================================================

" --- 1. SHORTCUT DELEGATION & LEADER KEY ---
" Ensure IdeaVim handles these key combinations instead of IDE hijacking
sethandler <Space> a:vim
sethandler <C-h> a:vim
sethandler <C-j> a:vim
sethandler <C-k> a:vim
sethandler <C-l> a:vim
sethandler <C-w> a:vim

" Clear default Space cursor motion before setting leader
map <Space> <Nop>
let mapleader = " "
let maplocalleader = " "

" --- 2. GENERAL OPTIONS & SENSITIVE DEFAULTS ---
set showmode
set incsearch
set hlsearch
set ignorecase
set smartcase
set scrolloff=8
set sidescrolloff=8
set number
set relativenumber=false

" Fast, responsive key evaluation (Zero input lag)
set timeout
set timeoutlen=300

" --- Native OS System Clipboard & JetBrains Paste Sync ---
set clipboard=unnamed,unnamedplus,ideaput

" --- 3. IDEAVIM NATIVE ENHANCEMENTS ---
set ideajoin              " Smart line join (J) recognizing language syntax
set ideastatusicon=enabled " Show IdeaVim mode icon in status bar
set idearefactormode=keep " Keep Vim mode active during IDE refactoring operations
set visualdelay=0

" Built-in Emulated Plugins
set surround              " Enable vim-surround (ys, cs, ds)
set multiple-cursors      " Enable multiple cursors (<A-n>, <A-x>, <A-p>)
set commentary            " Enable native commentary (gcc, gc)
set argtextobj            " Enable argument text objects (cia, daa)
set highlightedyank       " Highlight yanked text briefly
set ReplaceWithRegister   " Replace with register (gr)

" --- Tool Window & Split Navigation (Vim-parity across Explorer & Code) ---
set VimEverywhere          " Navigate seamlessly across splits & docked tool windows (Explorer, Terminal)

" --- NERDTree File Explorer Navigation ---
set NERDTree
let g:NERDTreeMapActivateNode = 'l'  " l: expand directory / open file
let g:NERDTreeMapJumpParent    = 'h'  " h: jump to parent directory

" ============================================================
" --- 4. SYNCHRONIZED KEYBINDINGS ---
" Note: In IdeaVim, <Action>(...) requires 'nmap'/'vmap' (not 'nnoremap')
" ============================================================

" --- Tab / Buffer Navigation (Exact Parity with Neovim & Vim) ---
nmap H <Action>(PreviousTab)
nmap L <Action>(NextTab)
nmap <S-h> <Action>(PreviousTab)
nmap <S-l> <Action>(NextTab)

" Jump directly to Tab 1 through 9 (Alt + 1..9)
nmap <A-1> <Action>(GoToTab1)
nmap <A-2> <Action>(GoToTab2)
nmap <A-3> <Action>(GoToTab3)
nmap <A-4> <Action>(GoToTab4)
nmap <A-5> <Action>(GoToTab5)
nmap <A-6> <Action>(GoToTab6)
nmap <A-7> <Action>(GoToTab7)
nmap <A-8> <Action>(GoToTab8)
nmap <A-9> <Action>(GoToTab9)

" --- File Explorer & Quick Search ---
nmap <leader>e :NERDTreeToggle<CR>

" Quick File Finder (Ctrl + P or <leader>ff)
nmap <C-p> <Action>(GotoFile)
nmap <leader>ff <Action>(GotoFile)

" Live Grep / Search Text in Project (Ctrl + F or <leader>fg)
nmap <C-f> <Action>(FindInPath)
nmap <leader>fg <Action>(FindInPath)

" Recent Files (<leader>fr)
nmap <leader>fr <Action>(RecentFiles)

" Switcher / Open Buffers (<leader>fb)
nmap <leader>fb <Action>(Switcher)

" Global Search & Replace (<leader>sr)
nmap <leader>sr <Action>(ReplaceInPath)

" Clear Search Highlight (<Esc>)
nnoremap <Esc> :nohlsearch<CR>

" --- Window Splits & Navigation (Ctrl + h/j/k/l & Ctrl + w) ---
nmap <leader>\| <Action>(SplitVertically)
nmap <leader>- <Action>(SplitHorizontally)

" Navigate between splits & tool windows (Explorer <-> Main Code Editor)
" With VimEverywhere enabled:
" - In Editor: <C-h> / <C-w>h navigates left into Explorer (Project View) or left split
" - In Explorer: <C-l> / <C-w>l navigates right into Main Code Editor
" - Up / Down: <C-k> / <C-w>k and <C-j> / <C-w>j move between vertical splits / bottom terminal
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Standard Vim window cycling (<C-w>w / <C-w><C-w>)
nnoremap <C-w>w <C-w>w
nnoremap <C-w><C-w> <C-w>w

" Resize split windows (Ctrl + Arrows)
nmap <C-Up> <Action>(ResizeToolWindowUp)
nmap <C-Down> <Action>(ResizeToolWindowDown)
nmap <C-Left> <Action>(ResizeToolWindowLeft)
nmap <C-Right> <Action>(ResizeToolWindowRight)

" --- Editing & Code Navigation ---
" Seamless Copy & Paste with System Clipboard (Insert & Command modes)
vmap <C-c> <Action>($Copy)
vmap <C-x> <Action>($Cut)
imap <C-v> <Action>($Paste)
cmap <C-v> <Action>($Paste)

" Wrapped line navigation
nnoremap j gj
nnoremap k gk
vnoremap j gj
vnoremap k gk

" Move Selected Lines Up / Down (Alt + j / Alt + k)
nmap <A-j> <Action>(MoveLineDown)
nmap <A-k> <Action>(MoveLineUp)
vmap <A-j> <Action>(MoveLineDown)
vmap <A-k> <Action>(MoveLineUp)

" Continuous Visual Indentation
vnoremap < <gv
vnoremap > >gv

" Integrated Terminal (<C-/> or <leader>ft)
nmap <C-/> <Action>(ActivateTerminalToolWindow)
nmap <leader>ft <Action>(ActivateTerminalToolWindow)

" --- Code Actions, Formatting & LSP ---
nmap <leader>ca <Action>(ShowIntentionActions)
nmap <leader>rn <Action>(RenameElement)
nmap <leader>cf <Action>(ReformatCode)

" Code navigation helpers
nmap gd <Action>(GotoDeclaration)
nmap gr <Action>(FindUsages)
nmap gi <Action>(GotoImplementation)
nmap K <Action>(QuickJavaDoc)
nmap [d <Action>(GotoPreviousError)
nmap ]d <Action>(GotoNextError)
